{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'VPS'|trans }}{% endblock %}
{% block body_class %}vps{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ 'vps'|url }}">{{ 'VPS'|trans }}</a></li>
    <li class="active breadcrumb-item" aria-current="page">{{ 'Manage'|trans }}</li>
{% endblock %}

{% block page_header %}
<article class="page-header">
    <h1>{{ 'Manage VPS'|trans }}</h1>
</article>
{% endblock %}

{% block content %}
{% if show_protected %}
{% set vm = client.vps_get_vmid_from_url() %}
{% if vm in client.vps_proxmox_vms_by_user(profile.id) %}
{% set vmData = client.vps_proxmox_vm_by_id(vm) %}
{% set statusArgs = [vm, 'status'] %}
{% set vmStatus = client.vps_proxmox_status_by_id(statusArgs)|default('unknown') %}
{% set uptimeArgs = [vm, 'uptime'] %}
{% set uptime = client.vps_proxmox_status_by_id(uptimeArgs) %}

<div class="row">
    <article class="span12 data-block">
        <div class="data-container">
            <header>
                <h4>{{ 'Manage VM'|trans }} {{ vm }}</h4>
            </header>
            <section>
                <style>
                    .vps-grid-row {
                        display: grid;
                        grid-template-columns: minmax(140px, 1.6fr) minmax(90px, 1fr) minmax(70px, 0.7fr) minmax(100px, 1fr) minmax(160px, 1.4fr) minmax(140px, 1.2fr) minmax(380px, 2.6fr);
                        gap: 0.5rem;
                        align-items: center;
                    }
                    .vps-grid-row.vps-grid-head { font-weight: 600; }
                    .vps-grid-cell { min-width: 0; }
                </style>

                <div class="vps-grid-row vps-grid-head mb-2">
                    <div class="vps-grid-cell">VM</div>
                    <div class="vps-grid-cell">{{ 'Uptime'|trans }}</div>
                    <div class="vps-grid-cell">vCPU</div>
                    <div class="vps-grid-cell">{{ 'Memory'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Disk'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Interfaces'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Action'|trans }}</div>
                </div>

                <div class="vps-grid-row mb-2">
                    <div class="vps-grid-cell">
                        <a href="{{ ('vps/control/vm/' ~ vm)|url }}">{{ vmData.name|default('VM #' ~ vm) }}</a>
                    </div>
                    <div class="vps-grid-cell"><small>{{ uptime is not null ? (uptime ~ ' ' ~ ('hours'|trans)) : '-' }}</small></div>
                    <div class="vps-grid-cell">{{ vmData.sockets|default('-') }}</div>
                    <div class="vps-grid-cell">{{ vmData.memory is defined ? (vmData.memory ~ 'MB') : '-' }}</div>
                    <div class="vps-grid-cell">
                        {% for disk in vmData.disk|default([]) %}
                            <div><small>{{ disk }}</small></div>
                        {% else %}
                            -
                        {% endfor %}
                    </div>
                    <div class="vps-grid-cell">
                        {% set seenNet = [] %}
                        {% for net in vmData.net|default([]) %}
                            {% set label = (net.mac|default('') ~ ' - ' ~ (net.vlan|default('Default'))) %}
                            {% if label not in seenNet %}
                                {% set seenNet = seenNet|merge([label]) %}
                                <div><small>{{ label }}</small></div>
                            {% endif %}
                        {% else %}
                            -
                        {% endfor %}
                    </div>
                    <div class="vps-grid-cell">
                        <div class="d-flex flex-nowrap gap-1">
                            {% if vmStatus != "running" %}
                                <button class="btn btn-primary btn-sm vm-action-btn" data-action="start" data-vmid="{{ vm }}" title="Power on" aria-label="Power on">▶</button>
                            {% endif %}
                            {% if vmStatus == "running" %}
                                <button class="btn btn-primary btn-sm vm-action-btn" data-action="reboot" data-vmid="{{ vm }}" title="Reboot" aria-label="Reboot">↻</button>
                                <button class="btn btn-secondary btn-sm vm-action-btn" data-action="stop" data-vmid="{{ vm }}" title="Power off" aria-label="Power off">⏹</button>
                            {% endif %}
                            <button class="btn btn-info btn-sm vm-action-btn" data-action="duplicate" data-vmid="{{ vm }}" data-vmname="{{ vmData.name|default('VM #' ~ vm)|e('html_attr') }}" title="Duplicate" aria-label="Duplicate">⧉</button>
                            <button class="btn btn-outline-primary btn-sm vm-action-btn" data-action="access" data-vmid="{{ vm }}" title="Access details" aria-label="Access details">🔐</button>
                            <button class="btn btn-outline-warning btn-sm vm-action-btn" data-action="reset-password" data-vmid="{{ vm }}" title="Reset root password" aria-label="Reset root password">🔑</button>
                            <button class="btn btn-outline-secondary btn-sm vm-action-btn" data-action="take-snapshot" data-vmid="{{ vm }}" title="Take snapshot" aria-label="Take snapshot">📸</button>
                            <a class="btn btn-dark btn-sm" href="{{ ('vps/control/vm/' ~ vm)|url }}" title="Open console" aria-label="Open console">🖥</a>
                            <button class="btn btn-danger btn-sm vm-action-btn" data-action="delete" data-vmid="{{ vm }}" title="Delete VM" aria-label="Delete VM">🗑</button>
                        </div>
                    </div>
                </div>

                <div id="manageVmActionStatus" class="small text-secondary mt-2"></div>
                <div class="mt-2">
                    <a class="btn btn-outline-secondary btn-sm" href="{{ 'vps'|url }}">{{ 'Back to VPS list'|trans }}</a>
                </div>
            </section>
        </div>
    </article>
</div>

<div class="modal fade" id="manageVmAccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'VM Access Details'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="manageVmAccessBody">
                <div class="d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                    <span>{{ 'Loading access details...'|trans }}</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="row">
    <article class="span12 data-block">
        <div class="data-container">
            <header>
                <h4>{{ 'Access denied'|trans }}</h4>
            </header>
            <section>
                <p>{{ 'You do not have access to this resource. If this VM belongs to you, please open a support ticket and we will add it to your account.'|trans }}</p>
            </section>
        </div>
    </article>
</div>
{% endif %}

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var vmid = {{ vm|default(0)|int }};
    var statusEl = document.getElementById('manageVmActionStatus');

    function setStatus(message, kind) {
        if (!statusEl) return;
        statusEl.className = 'small mt-2 ' + (kind === 'error' ? 'text-danger' : (kind === 'success' ? 'text-success' : 'text-secondary'));
        statusEl.textContent = message || '';
    }

    function postWithRetry(endpoint, payload, onSuccess) {
        var maxRetries = 5;
        var attempt = 0;
        function run() {
            attempt += 1;
            FOSSBilling.api.client.post(endpoint, payload, onSuccess, function(res) {
                if (attempt <= maxRetries) {
                    setStatus('{{ 'Host is busy, retrying...'|trans }} (' + attempt + '/' + maxRetries + ')', 'info');
                    setTimeout(run, 3000);
                    return;
                }
                setStatus((res.message || 'Request failed') + (res.code ? ' (' + res.code + ')' : ''), 'error');
            });
        }
        run();
    }

    function pollTask(endpoint, taskId, successMessage) {
        var attempts = 0;
        function check() {
            attempts += 1;
            FOSSBilling.api.client.post(endpoint, { task_id: taskId }, function(status) {
                if (status.status === 'completed') {
                    setStatus(successMessage, 'success');
                    window.setTimeout(function() { window.location.reload(); }, 1000);
                    return;
                }
                if (status.status === 'failed') {
                    setStatus(status.error_message || '{{ 'Action failed'|trans }}', 'error');
                    return;
                }
                if (attempts < 180) setTimeout(check, 5000);
            }, function() {
                if (attempts < 180) setTimeout(check, 5000);
            });
        }
        setTimeout(check, 2000);
    }

    function showAccessDetails() {
        var body = document.getElementById('manageVmAccessBody');
        if (!body) return;
        body.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Loading access details...'|trans }}</span></div>';
        FOSSBilling.api.client.post('vps/vm_access_details', { vmid: vmid }, function(result) {
            var html = '<p class="mb-2"><strong>' + (result.name || ('VM #' + vmid)) + '</strong></p>';
            html += '<p class="mb-2"><strong>{{ 'IP address'|trans }}:</strong> <code>' + (result.ip_address || '-') + '</code></p>';
            if (result.root_password) {
                html += '<p class="mb-2"><strong>{{ 'Root password'|trans }}:</strong> <code>' + result.root_password + '</code></p>';
            } else {
                html += '<p class="mb-0 text-secondary">{{ 'Root password is not available for this VM.'|trans }}</p>';
            }
            body.innerHTML = html;
        }, function(res) {
            body.innerHTML = '<p class="text-danger mb-0">' + (res.message || 'Failed to load access details') + '</p>';
        });
        new bootstrap.Modal(document.getElementById('manageVmAccessModal')).show();
    }

    function runSimpleAction(endpoint, successMessage, confirmText) {
        if (confirmText && !confirm(confirmText)) return;
        setStatus('{{ 'Submitting request...'|trans }}', 'info');
        postWithRetry(endpoint, { vmid: vmid }, function() {
            setStatus(successMessage, 'success');
            window.setTimeout(function() { window.location.reload(); }, 900);
        });
    }

    document.querySelectorAll('.vm-action-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            var action = button.dataset.action || '';
            if (action === 'start') return runSimpleAction('vps/vm_start', '{{ 'VM powered on'|trans }}');
            if (action === 'stop') return runSimpleAction('vps/vm_stop', '{{ 'VM powered off'|trans }}');
            if (action === 'reboot') return runSimpleAction('vps/vm_reboot', '{{ 'VM rebooted'|trans }}', '{{ 'Are you sure you want to reboot this VM?'|trans }}');
            if (action === 'access') return showAccessDetails();
            if (action === 'reset-password') {
                if (!confirm('{{ 'Reset root password now? This will restart cloud-init credential flow.'|trans }}')) return;
                setStatus('{{ 'Submitting request...'|trans }}', 'info');
                postWithRetry('vps/vm_reset_root_password', { vmid: vmid }, function(result) {
                    setStatus('{{ 'Root password reset complete'|trans }}: ' + (result.root_password || ''), 'success');
                });
                return;
            }
            if (action === 'duplicate') {
                var vmName = button.dataset.vmname || ('vm-' + vmid);
                var name = prompt('{{ 'New VM name'|trans }}', vmName + '-copy');
                if (!name) return;
                setStatus('{{ 'Submitting request...'|trans }}', 'info');
                postWithRetry('vps/vm_duplicate', { vmid: vmid, vm_name: name }, function(result) {
                    setStatus('{{ 'VM duplicated'|trans }}: ' + (result.vmid || ''), 'success');
                    window.setTimeout(function() { window.location.reload(); }, 900);
                });
                return;
            }
            if (action === 'take-snapshot') {
                if (!confirm('{{ 'Take a snapshot now?'|trans }}')) return;
                setStatus('{{ 'Submitting request...'|trans }}', 'info');
                postWithRetry('vps/vm_snapshot_take_async', { vmid: vmid }, function(result) {
                    if (result && result.task_id) {
                        setStatus('{{ 'Snapshot started in background...'|trans }}', 'info');
                        pollTask('vps/vm_snapshot_task_status', result.task_id, '{{ 'Snapshot created successfully'|trans }}');
                    }
                });
                return;
            }
            if (action === 'delete') {
                if (!confirm('{{ 'Delete this VM permanently?'|trans }}')) return;
                setStatus('{{ 'Submitting request...'|trans }}', 'info');
                postWithRetry('vps/vm_delete_async', { vmid: vmid }, function(result) {
                    if (result && result.task_id) {
                        setStatus('{{ 'Delete started in background...'|trans }}', 'info');
                        pollTask('vps/vm_delete_task_status', result.task_id, '{{ 'VM deleted successfully'|trans }}');
                    }
                });
            }
        });
    });
});
</script>
{% endif %}
{% endblock %}
