{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'VPS'|trans }}{% endblock %}

{% set loader_nr = request.loader | default("8")%}
{% set loader_url = ('img/assets/loaders/loader'~loader_nr~'.gif') %}

{% block body_class %}vps{% endblock %}
{% block breadcrumb %}
    <li class="active breadcrumb-item" aria-current="page">{{ 'VPS'|trans }}</li>
{% endblock %}
{% block content_before %}{% endblock %}

{% block page_header %}
<article class="page-header">
    <h1>{{ 'Manage VPS'|trans }}</h1>
</article>
{% endblock%}

{% block content %}
<div class="row">
    <article class="span12 data-block">
        <div class="data-container">
            <header>
                <h1>{{ 'Manage VPS'|trans }}</h1>
                <h2>{{ 'Create and manage virtual servers'|trans }}</h2>
            </header>
            <section>
            </section>
        </div>
    </article>
</div>

{% if show_protected %}
<div class="row">
    <article class="span12 data-block">
        <div class="data-container">
            <header>
							<h4>Virtual machines belonging to {{ profile.email }}</h4>
            </header>
            <section>
							<div class="row">
								<div class="col">VM</div>
								<div class="col">Uptime</div>
								<div class="col">vCPU</div>
								<div class="col">Memory</div>
								<div class="col">Disk</div>
								<div class="col">Interfaces</div>
								<div class="col">Action</div>
							</div>
{% set vms = client.vps_proxmox_vms_by_user(profile.id) %}
{% for vm in vms %}

{% set rendered %}
 {{ vm }}
{% endset %}
	<div class="row">
  {% set vmData = client.vps_proxmox_vm_by_id(vm) %}
		<div class="col">
			<a href="/vps/protected/manage/vm/{{vm}}">{{ vmData.name }}</a>
		</div>
		<div class="col">
			{% set argArray = [vm, 'uptime'] %}
      {% set uptime = client.vps_proxmox_status_by_id(argArray) %} 
			<small> {{ uptime }} hours</small>
		</div>
		<div class="col">
			{{ vmData.sockets }}
		</div>
		<div class="col">
			{{ vmData.memory }}MB
		</div>
		<div class="col">
			{% set disks = vmData.disk %}
			{% for disk in disks %}
  			{{ disk }}
			{% endfor %}
		</div>
		<div class="col">
			{% set nets = vmData.net %}
			{% for net in nets %}
				<small>{{net.mac}} - {{ net.vlan }}</small>
			{% endfor %}
		</div>
		<div class="col">
			{% set argArray = [vm, 'status'] %}
      {% set vmStatus = client.vps_proxmox_status_by_id(argArray) %}
      {% if vmStatus != "running" %}
			<button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#powerOnModal" onclick="populateModal('{{vm}}');">Power on</button>
			{% endif %}
      {% if vmStatus == "running" %}
			<button class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#powerOffModal" onclick="populateModal('{{vm}}');">Power off</button>
			{% endif %}
			<button class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#duplicateVmModal" onclick="duplicateModal('{{vm}}');">Duplicate</button>
		</div>
	</div>
{% endfor %}
<p>
            </section>
						<section>
							<h4>Create a VM</h4>
							<form action="{{ 'vps/protected/create'|url }}" method="post" id="create-vm" class="create-vm">
                <div class="modal-body">
                	<input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
									<input type="hidden" name="rel_type" value="order">
									<input type="hidden" name="rel_id" value="{{ order.id }}">
			            <input type="hidden" name="client_id" value="{{ profile.id }}">
      			      <input type="hidden" name="product_id" value="{{ product_id }}">

									<div class="mb-3">
										<label for="vm_name" class="form-label">{{ 'Name'|trans }}</label>
										<input class="form-control" type="text" name="vm_name" id="vm_name" value="{{ request.vm_name|e }}" required/>
									</div>
									<div class="mb-3">
										<label for="vm_os" class="form-label">{{ 'Operating System'|trans }}</label>
										<select class="form-select" name="vm_os" id="vm_os" aria-label="{{ 'Operating System'|trans }}">
											<option selected disabled>Choose operating system</option>
											<option value="alma9">AlmaLinux 9</option>
											<option value="alma10">AlmaLinux 10</option>
											<option value="rock9">Rocky Linux 9</option>
											<option value="rock10">Rocky Linux 10</option>
											<option value="cent9">CentOS Stream 9</option>
											<option value="cent10">CentOS Stream 10</option>
											<option value="ubu22">Ubuntu 22.04</option>
											<option value="ubu24">Ubuntu 24.04</option>
											<option value="ubu26">Ubuntu 26.04</option>
											<option value="deb135">Debian 12.10.0</option>
											<option value="bsd151">FreeBSD 14.2</option>
											<option value="win19">Windows Server 2019</option>
											<option value="win22">Windows Server 2022</option>
										</select>
									</div>
									<div class="row mb-3">
										<div class="col-6">
											<label for="vm_cpu" class="form-label">{{ 'vCPU'|trans }}</label>
											<input type="range" class="form-range" min="2" max="64" step="2" name="vm_cpu" id="vm_cpu" value="2" oninput="this.nextElementSibling.value = this.value" required/>
											<output class="vm_disk_size_value">2</output> vCPU
										</div>
										<div class="col-6">
											<label for="vm_mem" class="form-label">{{ 'Memory'|trans }}</label>
											<input type="range" class="form-range" min="4" max="64" step="2" name="vm_mem" id="vm_mem" value="2" oninput="this.nextElementSibling.value = this.value" required/>
											<output class="vm_disk_size_value">4</output> GB
										</div>
									</div>
									<div class="row mb-3">
										<div class="col-6">
											<label for="vm_disk_size" class="form-label">{{ 'Disk Size'|trans }}</label>
											<input type="range" class="form-range" min="10" max="1000" step="5" name="vm_disk_size" id="vm_disk_size" value="10" oninput="this.nextElementSibling.value = this.value" required/>
											<output class="vm_disk_size_value">10</output> GB
										</div>
										<div class="col-6">
											<label for="vm_disk_type" class="form-label">{{ 'Disk Type'|trans }}</label>
											<select class="form-select" name="vm_disk_type" id="vm_disk_type" aria-label="{{ 'Disk Type'|trans }}">
												<option value="sata">SATA</option>
												<option value="ssd">SSD</option>
											</select>
										</div>
									</div>
									<div class="row">
										<div class="col-2">
											<label for="vm_cost" class="form-label">{{ 'VM Cost'|trans }}</label>
											<input class="form-control" type="text" name="vm_cost" id="vm_cost" value="$7.00" disabled required/>
										</div>
									</div>
								</div>
								<div class="modal-footer">
									<button type="submit" class="provision btn btn-danger" disabled>{{ 'Provision'|trans }}</button>
								</div>
							</form>

						</section>
        </div>
    </article>
</div>

<div class="modal fade" id="powerOnModal" tabindex="-1" aria-labelledby="powerOnModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="powerOnLabel">Power on</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to power on this VM? CPU and disk usage will accrue towards your monthly expenses.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, close</button>
        <button type="button" class="btn btn-primary btn-power-on" data-bs-id="">Power on</button>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="powerOffModal" tabindex="-1" aria-labelledby="powerOffModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="powerOffLabel">Power off</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to power off this VM? CPU usage will stop counting toward your monthly tab, but disk usage will continue to accrue unless the VM is deleted.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, go back</button>
        <button type="button" class="btn btn-danger btn-power-off" data-bs-id="">Power off</button>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="duplicateVmModal" tabindex="-1" aria-labelledby="duplicateVmModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="duplicateVmLabel">Duplicate VM</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
				Are you sure you want to duplicate this VM?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, go back</button>
        <button type="button" class="btn btn-info btn-power-off" data-bs-id="">Proceed</button>
      </div>
    </div>
  </div>
</div>


<script type="text/javascript">
function populateModal(vm){
  console.log(vm);
}

function formatCurrency(total) {
	var neg = false;
	if(total < 0) {
		neg = true;
		total = Math.abs(total);
	}
	return (neg ? "-$" : '$') + parseFloat(total, 10).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, "$1,").toString();
}
var vm_disk_size = '10';
var vm_cpu = '2';
var vm_mem = '2';
var vm_disk_type = 'sata';

function calculate(){
	var vm_disk_type = $('#vm_disk_type').val();
	var vm_disk_size = $('#vm_disk_size').val();
	var vm_cpu = $('#vm_cpu').val();
	var vm_mem = $('#vm_mem').val();
	if (vm_disk_type == 'ssd') {
		var vm_disk_cost = (vm_disk_size * 0.5);
	} else if (vm_disk_type == 'sata') {
		var vm_disk_cost = (vm_disk_size * 0.2);
  }
  var vm_cpu_cost = (vm_cpu * 1.3);
	var vm_mem_cost = (vm_mem * 1.2);
  var vm_cost = (vm_disk_cost + vm_cpu_cost + vm_mem_cost);
	$('#vm_cost').val(formatCurrency(vm_cost));
	$('.provision').prop('disabled',false) 
}

$('#vm_disk_size').click(function(event){
	calculate();
});
$('#vm_cpu').click(function(event){
	calculate();
});
$('#vm_mem').click(function(event){
	calculate();
});
$('#vm_disk_type').on('change',function(event){
	calculate();
});

</script>
{% endif %}
{% endblock %}
