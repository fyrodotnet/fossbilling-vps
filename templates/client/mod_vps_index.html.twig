            attempts += 1;
            FOSSBilling.api.client.post('vps/provision_task_status', { task_id: taskId },
                function(status) {
                    if (status.status === 'completed') {
                        var vmid = status.result && status.result.vmid ? status.result.vmid : status.vmid;
                        var vmName = status.result && status.result.name ? status.result.name : '';
                        var ipAddress = status.result && status.result.ip_address ? status.result.ip_address : '';
                        modalBody.innerHTML =
                            '<p class="text-success mb-2"><strong>{{ 'VM provisioned successfully'|trans }}</strong></p>' +
                            '<p class="mb-1">{{ 'VM ID'|trans }}: <strong>' + escapeHtml(vmid) + '</strong></p>' +
                            '<p class="mb-1">{{ 'Name'|trans }}: <strong>' + escapeHtml(vmName || ('VM #' + vmid)) + '</strong></p>' +
                            '<p class="mb-0">{{ 'IP address'|trans }}: <strong>' + escapeHtml(ipAddress || '-') + '</strong></p>' +
                            '<p class="small text-secondary mt-2 mb-0">{{ 'Use Access details to view and copy credentials.'|trans }}</p>' +
                            '<p class="small text-secondary mt-1 mb-0">{{ 'Refreshing VM list...'|trans }}</p>';
                        modalFooter.classList.remove('d-none');
                        window.setTimeout(function() {
                            window.location.reload();
                        }, 1500);
                        return;
                    }

                    if (status.status === 'failed') {
                        modalBody.innerHTML = '<p class="text-danger mb-0"><strong>{{ 'Provisioning failed'|trans }}</strong><br>' + escapeHtml(status.error_message || 'Unknown error') + '</p>';
                        modalFooter.classList.remove('d-none');
                        return;
                    }

                    if (attempts < maxAttempts) {
                        setTimeout(pollStatus, 5000);
                        return;
                    }

                    modalBody.innerHTML = '<p class="text-warning mb-0"><strong>{{ 'Provisioning is still running in the background.'|trans }}</strong><br>{{ 'You can close this page and check back later.'|trans }}</p>';
                    modalFooter.classList.remove('d-none');
                },
                function() {
                    if (attempts < maxAttempts) {
                        setTimeout(pollStatus, 5000);
                        return;
                    }
                    modalBody.innerHTML = '<p class="text-warning mb-0"><strong>{{ 'Provisioning status check failed.'|trans }}</strong><br>{{ 'You can close this page; provisioning may still continue in background.'|trans }}</p>';
                    modalFooter.classList.remove('d-none');
                }
            );
        }

        modalBody.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Provisioning queued. Monitoring status...'|trans }}</span></div><p class="small text-secondary mt-2 mb-0">{{ 'You can close this page at any time. The task will keep running.'|trans }}</p>';
        modalFooter.classList.add('d-none');
        setTimeout(pollStatus, 2500);
    }

    function renderContainerQueued(modalBody, modalFooter, taskId) {
        modalBody.innerHTML =
            '<p class="text-success mb-2"><strong>{{ 'Container provisioning started in the background.'|trans }}</strong></p>' +
            '<p class="mb-2">{{ 'Task ID'|trans }}: <code>' + escapeHtml(taskId) + '</code></p>' +
            '<p class="small text-secondary mb-0">{{ 'You can close this page now. Provisioning will continue on the server.'|trans }}</p>';
        modalFooter.classList.remove('d-none');
    }

    function monitorContainerTask(taskId, modalBody, modalFooter) {
        var attempts = 0;
        var maxAttempts = 180;

        function pollStatus() {
            attempts += 1;
            FOSSBilling.api.client.post('vps/container_provision_task_status', { task_id: taskId },
                function(status) {
                    if (status.status === 'completed') {
                        var ctid = status.result && status.result.ctid ? status.result.ctid : status.ctid;
                        var ctName = status.result && status.result.name ? status.result.name : '';
                        var ipAddress = status.result && status.result.ip_address ? status.result.ip_address : '';
                        var rootPassword = status.result && status.result.root_password ? status.result.root_password : '';
                        var networkMode = status.result && status.result.network_mode ? status.result.network_mode : '';
                        var applicationUrl = status.result && status.result.application_url ? status.result.application_url : (ipAddress ? ('http://' + ipAddress) : '');
                        var sshCommand = status.result && status.result.ssh_command ? status.result.ssh_command : (ipAddress ? ('ssh root@' + ipAddress) : '');
                        var accessHints = status.result && status.result.access_hints ? status.result.access_hints : null;
                        var hintHtml = '';
                        if (applicationUrl || (accessHints && accessHints.likely_web_url)) {
                            var appUrl = applicationUrl || accessHints.likely_web_url;
                            hintHtml += '<p class="mb-1">{{ 'Application URL'|trans }}: <a href=\"' + escapeHtml(appUrl) + '\" target=\"_blank\" rel=\"noopener noreferrer\">' + escapeHtml(appUrl) + '</a></p>';
                        }
                        if (accessHints && accessHints.likely_admin_url) {
                            hintHtml += '<p class="mb-1">{{ 'Admin URL'|trans }}: <a href=\"' + escapeHtml(accessHints.likely_admin_url) + '\" target=\"_blank\" rel=\"noopener noreferrer\">' + escapeHtml(accessHints.likely_admin_url) + '</a></p>';
                        }
                        if (sshCommand || (accessHints && accessHints.ssh_command)) {
                            hintHtml += '<p class="mb-1">{{ 'SSH command'|trans }}: <code>' + escapeHtml(sshCommand || accessHints.ssh_command) + '</code></p>';
                        }
                        if (accessHints && accessHints.username_hint) {
                            hintHtml += '<p class="small text-secondary mb-1">' + escapeHtml(accessHints.username_hint) + '</p>';
                        }
                        hintHtml += '<p class="small text-danger mb-0">{{ 'If you have provisioned a VM on the internal network, be sure you are connected to the VPN at https://vpn.domain.com'|trans }}</p>';
                        modalBody.innerHTML =
                            '<p class="text-success mb-2"><strong>{{ 'Container provisioned successfully'|trans }}</strong></p>' +
                            '<p class="mb-1">{{ 'Container ID'|trans }}: <strong>' + escapeHtml(ctid) + '</strong></p>' +
                            '<p class="mb-1">{{ 'Name'|trans }}: <strong>' + escapeHtml(ctName || ('CT #' + ctid)) + '</strong></p>' +
                            '<p class="mb-1">{{ 'IP address'|trans }}: <strong>' + escapeHtml(ipAddress || '-') + '</strong></p>' +
                            '<p class="mb-1">{{ 'Network mode'|trans }}: <strong>' + escapeHtml(networkMode || '-') + '</strong></p>' +
                            '<p class="mb-1">{{ 'Root password'|trans }}: <code>' + escapeHtml(rootPassword || '') + '</code></p>' +
                            hintHtml;
                        modalFooter.classList.remove('d-none');
                        return;
                    }

                    if (status.status === 'failed') {
                        modalBody.innerHTML = '<p class="text-danger mb-0"><strong>{{ 'Container provisioning failed'|trans }}</strong><br>' + escapeHtml(status.error_message || 'Unknown error') + '</p>';
                        modalFooter.classList.remove('d-none');
                        return;
                    }

                    if (attempts < maxAttempts) {
                        setTimeout(pollStatus, 5000);
                        return;
                    }

                    modalBody.innerHTML = '<p class="text-warning mb-0"><strong>{{ 'Container provisioning is still running in the background.'|trans }}</strong><br>{{ 'You can close this page and check back later.'|trans }}</p>';
                    modalFooter.classList.remove('d-none');
                },
                function() {
                    if (attempts < maxAttempts) {
                        setTimeout(pollStatus, 5000);
                        return;
                    }
                    modalBody.innerHTML = '<p class="text-warning mb-0"><strong>{{ 'Container status check failed.'|trans }}</strong><br>{{ 'You can close this page; provisioning may still continue in background.'|trans }}</p>';
                    modalFooter.classList.remove('d-none');
                }
            );
        }

        modalBody.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Container queued. Monitoring status...'|trans }}</span></div><p class="small text-secondary mt-2 mb-0">{{ 'You can close this page at any time. The task will keep running.'|trans }}</p>';
        modalFooter.classList.add('d-none');
        setTimeout(pollStatus, 2500);
    }

    function calculate() {
        var vmDiskType = document.getElementById('vm_disk_type');
        var vmDiskSize = document.getElementById('vm_disk_size');
        var vmCpu = document.getElementById('vm_cpu');
        var vmMem = document.getElementById('vm_mem');
        var vmCost = document.getElementById('vm_cost');
        var vmCostHidden = document.getElementById('vm_cost_hidden');
        var provisionButton = document.querySelector('.provision');
        var eligibilityNote = document.getElementById('provision-eligibility-note');
        var vmOs = document.getElementById('vm_os');
        var vmName = document.getElementById('vm_name');

        if (!vmDiskType || !vmDiskSize || !vmCpu || !vmMem || !vmCost || !provisionButton || !vmOs || !vmName) {
            return;
        }

        var diskType = vmDiskType.value;
        var diskSize = parseFloat(vmDiskSize.value) || 0;
        var cpu = parseFloat(vmCpu.value) || 0;
        var mem = parseFloat(vmMem.value) || 0;
        var diskCost = diskType === 'ssd' ? diskSize * 0.5 : diskSize * 0.2;
        var cpuCost = cpu * 1.3;
        var memCost = mem * 1.2;
        var cost = diskCost + cpuCost + memCost;

        vmCost.value = formatCurrency(cost);
        if (vmCostHidden) {
            vmCostHidden.value = cost.toFixed(2);
        }

        var canPay = billingBypassEnabled || hasActiveSubscription || currentBalance >= cost;
        if (vmName.value.trim() !== '' && vmOs.value !== '' && canPay) {
            provisionButton.removeAttribute('disabled');
        } else {
            provisionButton.setAttribute('disabled', 'disabled');
        }

        if (!eligibilityNote) {
            return;
        }
        if (billingBypassEnabled) {
            eligibilityNote.textContent = '{{ 'Billing checks are bypassed for testing.'|trans }}';
            eligibilityNote.className = 'small mt-2 mb-0 text-warning';
            return;
        }
        if (hasActiveSubscription) {
            eligibilityNote.textContent = '{{ 'Active VPS subscription detected. Provisioning is allowed.'|trans }}';
            eligibilityNote.className = 'small mt-2 mb-0 text-success';
            return;
        }

        if (currentBalance >= cost) {
            eligibilityNote.textContent = '{{ 'Your balance covers at least one month of this VM cost.'|trans }}';
            eligibilityNote.className = 'small mt-2 mb-0 text-success';
        } else {
            eligibilityNote.textContent = '{{ 'Insufficient balance for one month. Add funds or maintain an active VPS subscription.'|trans }}';
            eligibilityNote.className = 'small mt-2 mb-0 text-danger';
        }
    }

    function calculateContainerEligibility() {
        var ctDiskSize = document.getElementById('ct_disk_size');
        var ctDiskType = document.getElementById('ct_disk_type');
        var ctTemplate = document.getElementById('ct_template');
        var ctName = document.getElementById('ct_name');
        var ctCost = document.getElementById('ct_cost');
        var ctStoragePreview = document.getElementById('ct_storage_preview');
        var ctProvisionButton = document.querySelector('.container-provision-btn');
        var eligibilityNote = document.getElementById('container-eligibility-note');

        if (!ctDiskSize || !ctDiskType || !ctTemplate || !ctName || !ctCost || !ctProvisionButton || !eligibilityNote) {
            return;
        }

        var diskSize = parseFloat(ctDiskSize.value) || 10;
        var diskType = String(ctDiskType.value || 'sata');
        var storage = diskType === 'ssd' ? 'nas2-vm-fast' : 'nas2-vm-slow';
        var diskRate = diskType === 'ssd' ? 0.5 : 0.2;
        var cost = diskSize * diskRate;
        ctCost.value = formatCurrency(cost);
        if (ctStoragePreview) {
            ctStoragePreview.value = storage;
        }

        var canPay = billingBypassEnabled || hasActiveSubscription || currentBalance >= cost;
        if (ctName.value.trim() !== '' && ctTemplate.value !== '' && canPay) {
            ctProvisionButton.removeAttribute('disabled');
        } else {
            ctProvisionButton.setAttribute('disabled', 'disabled');
        }

        if (billingBypassEnabled) {
            eligibilityNote.textContent = '{{ 'Billing checks are bypassed for testing.'|trans }}';
            eligibilityNote.className = 'small mb-2 text-warning';
            return;
        }
        if (hasActiveSubscription) {
            eligibilityNote.textContent = '{{ 'Active VPS subscription detected. Provisioning is allowed.'|trans }}';
            eligibilityNote.className = 'small mb-2 text-success';
            return;
        }
        if (currentBalance >= cost) {
            eligibilityNote.textContent = '{{ 'Your balance covers at least one month of this container cost.'|trans }}';
            eligibilityNote.className = 'small mb-2 text-success';
        } else {
            eligibilityNote.textContent = '{{ 'Insufficient balance for one month. Add funds or maintain an active VPS subscription.'|trans }}';
            eligibilityNote.className = 'small mb-2 text-danger';
        }
    }

    ['vm_cpu', 'vm_mem', 'vm_disk_size', 'vm_disk_type', 'vm_os', 'vm_name'].forEach(function(id) {
        var input = document.getElementById(id);
        if (!input) {
            return;
        }
        var eventType = input.tagName.toLowerCase() === 'select' ? 'change' : 'input';
        input.addEventListener(eventType, calculate);
    });

    ['ct_disk_size', 'ct_disk_type', 'ct_template', 'ct_name'].forEach(function(id) {
        var input = document.getElementById(id);
        if (!input) {
            return;
        }
        var eventType = input.tagName.toLowerCase() === 'select' ? 'change' : 'input';
        input.addEventListener(eventType, calculateContainerEligibility);
    });

    calculate();
    calculateContainerEligibility();
    loadFolderState(function() {
        groupVmRowsByFolder();
        groupContainerRowsByFolder();
    });

    var createForm = document.getElementById('create-vm');
    createForm?.addEventListener('submit', function(event) {
        event.preventDefault();

        var modalBody = document.getElementById('provisionVmModalBody');
        var modalFooter = document.getElementById('provisionVmModalFooter');
        modalBody.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Queueing VM provisioning...'|trans }}</span></div><p class="small text-secondary mt-2 mb-0">{{ 'This request returns quickly. You can close this page once queued.'|trans }}</p>';
        modalFooter.classList.add('d-none');
        getProvisionModal().show();

        postWithRetry(
            'vps/provision_vm',
            FOSSBilling.tools.serializeFormDataToObject(new FormData(createForm)),
            {
            retries: 5,
            delayMs: 3000,
            onRetry: function(attempt, retries) {
                modalBody.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Provisioning request is retrying...'|trans }} (' + attempt + '/' + retries + ')</span></div><p class="small text-secondary mt-2 mb-0">{{ 'Host is busy, retrying automatically.'|trans }}</p>';
            },
            onSuccess: function(result) {
                if (!result || !result.task_id) {
                    modalBody.innerHTML = '<p class="text-danger mb-0"><strong>{{ 'Provisioning failed'|trans }}</strong><br>{{ 'No task ID returned by the server.'|trans }}</p>';
                    modalFooter.classList.remove('d-none');
                    return;
                }

                renderProvisionQueued(modalBody, modalFooter, result.task_id);
                monitorProvisionTask(result.task_id, modalBody, modalFooter);
            },
            onFailure: function(res) {
                modalBody.innerHTML = '<p class="text-danger mb-0"><strong>{{ 'Provisioning failed'|trans }}</strong><br>' + (res.message || 'Unknown error') + (res.code ? ' (' + res.code + ')' : '') + '</p>';
                modalFooter.classList.remove('d-none');
            }
        });
    });

    var createContainerForm = document.getElementById('create-container');
    createContainerForm?.addEventListener('submit', function(event) {
        event.preventDefault();

        var modalBody = document.getElementById('provisionContainerModalBody');
        var modalFooter = document.getElementById('provisionContainerModalFooter');
        modalBody.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Queueing container provisioning...'|trans }}</span></div><p class="small text-secondary mt-2 mb-0">{{ 'This request returns quickly. You can close this page once queued.'|trans }}</p>';
        modalFooter.classList.add('d-none');
        getProvisionContainerModal().show();

        postWithRetry(
            'vps/container_provision',
            FOSSBilling.tools.serializeFormDataToObject(new FormData(createContainerForm)),
            {
            retries: 5,
            delayMs: 3000,
            onRetry: function(attempt, retries) {
                modalBody.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Container request is retrying...'|trans }} (' + attempt + '/' + retries + ')</span></div><p class="small text-secondary mt-2 mb-0">{{ 'Host is busy, retrying automatically.'|trans }}</p>';
            },
            onSuccess: function(result) {
                if (!result || !result.task_id) {
                    modalBody.innerHTML = '<p class="text-danger mb-0"><strong>{{ 'Container provisioning failed'|trans }}</strong><br>{{ 'No task ID returned by the server.'|trans }}</p>';
                    modalFooter.classList.remove('d-none');
                    return;
                }

                renderContainerQueued(modalBody, modalFooter, result.task_id);
                monitorContainerTask(result.task_id, modalBody, modalFooter);
            },
            onFailure: function(res) {
                modalBody.innerHTML = '<p class="text-danger mb-0"><strong>{{ 'Container provisioning failed'|trans }}</strong><br>' + (res.message || 'Unknown error') + (res.code ? ' (' + res.code + ')' : '') + '</p>';
                modalFooter.classList.remove('d-none');
            }
        });
    });
});
</script>
{% endif %}
{% endblock %}
