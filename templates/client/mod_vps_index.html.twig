            return;
        }

        body.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Loading access details...'|trans }}</span></div>';

        FOSSBilling.api.client.post('vps/vm_access_details', { vmid: selectedVmid },
            function(result) {
                var vmName = result && result.name ? result.name : ('VM #' + selectedVmid);
                var ipAddress = result && result.ip_address ? result.ip_address : '-';
                var rootPassword = result && result.root_password ? result.root_password : '';
                var hasPassword = !!(result && result.has_root_password && rootPassword !== '');
                var html = '<p class="mb-2"><strong>' + escapeHtml(vmName) + '</strong></p>';
                html += '<p class="mb-2"><strong>{{ 'IP address'|trans }}:</strong> <code>' + escapeHtml(ipAddress) + '</code></p>';

                if (hasPassword) {
                    html += '<p class="mb-2"><strong>{{ 'Root password'|trans }}:</strong> <code id="vm-root-password">' + escapeHtml(rootPassword) + '</code></p>';
                    html += '<button type="button" class="btn btn-sm btn-outline-secondary" id="copy-root-password">{{ 'Copy root password'|trans }}</button>';
                } else {
                    html += '<p class="mb-0 text-secondary">{{ 'Root password is not available for this VM.'|trans }}</p>';
                }
                body.innerHTML = html;

                var copyButton = document.getElementById('copy-root-password');
                if (copyButton && hasPassword) {
                    copyButton.addEventListener('click', function() {
