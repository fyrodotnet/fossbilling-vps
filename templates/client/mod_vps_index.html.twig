{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'VPS'|trans }}{% endblock %}

{% set isContainersPage = containers_page|default(false) %}
{% set active_menu = isContainersPage ? 'containers' : 'vps' %}
{% set loader_nr = request.loader | default("8")%}
{% set loader_url = ('img/assets/loaders/loader'~loader_nr~'.gif') %}

{% block body_class %}vps{% endblock %}
{% block breadcrumb %}
    <li class="active breadcrumb-item" aria-current="page">{{ isContainersPage ? ('Containers'|trans) : ('VPS'|trans) }}</li>
{% endblock %}
{% block content_before %}{% endblock %}

{% block page_header %}
<article class="page-header">
    <h1>{{ isContainersPage ? ('Containers'|trans) : ('Provision VPS'|trans) }}</h1>
</article>
{% endblock%}

{% block content %}
{% set showContainerUi = isContainersPage %}
<div class="row">
    <article class="span12 data-block">
        <div class="data-container">
            <header>
                <h1>{{ isContainersPage ? ('Containers'|trans) : ('Provision VPS'|trans) }}</h1>
                <h2>{{ isContainersPage ? ('Provision and manage containers'|trans) : ('Create and manage virtual servers'|trans) }}</h2>
            </header>
        </div>
    </article>
</div>

{% if show_protected %}
{% set currentBalance = client.client_balance_get_total|default(0) %}
{% set hasActiveSubscription = client.vps_has_active_subscription() %}
{% set billingBypassEnabled = client.vps_billing_bypass_enabled() %}
<div class="row">
    <article class="span12 data-block">
        <div class="data-container">
            <header>
                <h4>
                    {% if isContainersPage %}
                        {{ 'Containers belonging to'|trans }} {{ profile.email }}
                    {% else %}
                        {{ 'Virtual machines belonging to'|trans }} {{ profile.email }}
                    {% endif %}
                </h4>
            </header>
            <section>
                <div class="d-flex gap-2 mb-2">
                    <input type="text" class="form-control" id="newVmFolderName" placeholder="{{ 'New folder name'|trans }}" maxlength="64">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="createVmFolderBtn">{{ 'Create folder'|trans }}</button>
                    <select class="form-select form-select-sm" id="deleteVmFolderSelect" style="max-width: 220px;">
                        <option value="">{{ 'Select folder to delete'|trans }}</option>
                    </select>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="deleteVmFolderBtn">{{ 'Delete folder'|trans }}</button>
                </div>
                <style>
                    .vps-grid-row {
                        display: grid;
                        grid-template-columns: minmax(140px, 1.6fr) minmax(90px, 1fr) minmax(70px, 0.7fr) minmax(100px, 1fr) minmax(140px, 1.4fr) minmax(130px, 1.2fr) minmax(380px, 2.6fr);
                        gap: 0.5rem;
                        align-items: center;
                    }
                    .vps-grid-row.vps-grid-head {
                        font-weight: 600;
                    }
                    .vps-grid-cell {
                        min-width: 0;
                    }
                    .vm-snapshot-row {
                        display: grid;
                        grid-template-columns: 1fr;
                        padding: 0.25rem 0 0.75rem;
                    }
                    .vm-snapshot-box {
                        border: 1px solid rgba(127, 127, 127, 0.3);
                        border-radius: 0.5rem;
                        padding: 0.5rem 0.75rem;
                        background: rgba(127, 127, 127, 0.08);
                    }
                    .vm-snapshot-item {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 0.5rem;
                        padding: 0.25rem 0;
                    }
                </style>
                {% if not isContainersPage %}
                <div class="vps-grid-row vps-grid-head mb-2">
                    <div class="vps-grid-cell">VM</div>
                    <div class="vps-grid-cell">{{ 'Uptime'|trans }}</div>
                    <div class="vps-grid-cell">vCPU</div>
                    <div class="vps-grid-cell">{{ 'Memory'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Disk'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'IP Address'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Action'|trans }}</div>
                </div>
{% set vmRows = client.vps_vms_overview() %}
<div id="vpsVmRowsContainer">
{% for vm in vmRows %}
    <div class="vps-grid-row mb-2 vm-row" data-vmid="{{ vm.vmid }}">
        <div class="vps-grid-cell">
            <a href="{{ ('vps/manage/vm/' ~ vm.vmid)|url }}">{{ vm.name|default('VM #' ~ vm.vmid) }}</a>
        </div>
        <div class="vps-grid-cell">
            <small>
                {% if vm.uptime_hours is not null %}
                    {{ vm.uptime_hours }} {{ 'hours'|trans }}
                {% else %}
                    -
                {% endif %}
            </small>
        </div>
        <div class="vps-grid-cell">{{ vm.vcpu is not null ? vm.vcpu : '-' }}</div>
        <div class="vps-grid-cell">{{ vm.memory_mb is not null ? (vm.memory_mb ~ 'MB') : '-' }}</div>
        <div class="vps-grid-cell">
            {% if vm.disk_size > 0 %}
                {{ vm.disk_size }} GB{% if vm.disk_type %} ({{ vm.disk_type|upper }}){% endif %}
            {% else %}
                -
            {% endif %}
        </div>
        <div class="vps-grid-cell"><small>{{ vm.ip_address ?: '-' }}</small></div>
        <div class="vps-grid-cell">
            {% set vmStatus = vm.status|default('unknown') %}
            <div class="d-flex flex-nowrap gap-1">
                {% if vmStatus != "running" %}
                    <button class="btn btn-primary btn-sm vm-action-btn" title="{{ 'Power on'|trans }}" aria-label="{{ 'Power on'|trans }}" data-action="start" data-vmid="{{ vm.vmid }}" data-bs-toggle="modal" data-bs-target="#powerOnModal">▶</button>
                {% endif %}
                {% if vmStatus == "running" %}
                    <button class="btn btn-primary btn-sm vm-action-btn" title="{{ 'Reboot'|trans }}" aria-label="{{ 'Reboot'|trans }}" data-action="reboot" data-vmid="{{ vm.vmid }}" data-bs-toggle="modal" data-bs-target="#rebootVmModal">↻</button>
                    <button class="btn btn-secondary btn-sm vm-action-btn" title="{{ 'Power off'|trans }}" aria-label="{{ 'Power off'|trans }}" data-action="stop" data-vmid="{{ vm.vmid }}" data-bs-toggle="modal" data-bs-target="#powerOffModal">⏹</button>
                {% endif %}
                <button class="btn btn-info btn-sm vm-action-btn" title="{{ 'Duplicate'|trans }}" aria-label="{{ 'Duplicate'|trans }}" data-action="duplicate" data-vmid="{{ vm.vmid }}" data-vmname="{{ vm.name|default('VM #' ~ vm.vmid)|e('html_attr') }}" data-bs-toggle="modal" data-bs-target="#duplicateVmModal">⧉</button>
                <button class="btn btn-outline-primary btn-sm vm-action-btn" title="{{ 'Access details'|trans }}" aria-label="{{ 'Access details'|trans }}" data-action="access" data-vmid="{{ vm.vmid }}" data-vmname="{{ vm.name|default('VM #' ~ vm.vmid)|e('html_attr') }}" data-bs-toggle="modal" data-bs-target="#vmAccessModal">🔐</button>
                <button class="btn btn-outline-warning btn-sm vm-action-btn" title="{{ 'Reset root password'|trans }}" aria-label="{{ 'Reset root password'|trans }}" data-action="reset-password" data-vmid="{{ vm.vmid }}">🔑</button>
                <button class="btn btn-outline-secondary btn-sm vm-action-btn" title="{{ 'Take snapshot'|trans }}" aria-label="{{ 'Take snapshot'|trans }}" data-action="take-snapshot" data-vmid="{{ vm.vmid }}" data-vmname="{{ vm.name|default('VM #' ~ vm.vmid)|e('html_attr') }}">📸</button>
                <a class="btn btn-dark btn-sm" title="{{ 'View console'|trans }}" aria-label="{{ 'View console'|trans }}" href="{{ ('vps/control/vm/' ~ vm.vmid)|url }}">🖥</a>
                <button class="btn btn-danger btn-sm vm-action-btn" title="{{ 'Delete VM'|trans }}" aria-label="{{ 'Delete VM'|trans }}" data-action="delete" data-vmid="{{ vm.vmid }}" data-vmname="{{ vm.name|default('VM #' ~ vm.vmid)|e('html_attr') }}" data-bs-toggle="modal" data-bs-target="#deleteVmModal">🗑</button>
            </div>
        </div>
    </div>
    {% if vm.snapshots is not empty %}
    <div class="vm-snapshot-row mb-2" data-vmid="{{ vm.vmid }}">
        <div class="vm-snapshot-box">
            <div class="small text-secondary mb-1">
                {{ 'Snapshots'|trans }}:
                {{ vm.snapshot_total_size_gb|default(0)|number_format(2, '.', ',') }} GB
                ({{ '$' ~ vm.snapshot_monthly_cost|default(0)|number_format(2, '.', ',') }}/{{ 'month'|trans }})
            </div>
            {% for snapshot in vm.snapshots %}
                <div class="vm-snapshot-item">
                    <div>
                        <strong>{{ snapshot.name }}</strong>
                        <small class="text-secondary">
                            - {{ snapshot.size_gb|number_format(2, '.', ',') }} GB
                            ({{ '$' ~ snapshot.monthly_cost|number_format(2, '.', ',') }}/{{ 'month'|trans }})
                        </small>
                    </div>
                    <button
                        class="btn btn-outline-success btn-sm vm-snapshot-restore-btn"
                        data-vmid="{{ vm.vmid }}"
                        data-snapshot-name="{{ snapshot.name|e('html_attr') }}"
                    >{{ 'Restore'|trans }}</button>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
{% else %}
    <p class="text-secondary">{{ 'No virtual machines found for your account yet.'|trans }}</p>
{% endfor %}
</div>
                {% endif %}
            </section>
            {% if showContainerUi %}
            <section class="mt-4">
                <header>
                    <h4>{{ 'Containers'|trans }}</h4>
                </header>
                <div class="vps-grid-row vps-grid-head mb-2">
                    <div class="vps-grid-cell">CT</div>
                    <div class="vps-grid-cell">{{ 'Uptime'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Status'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Memory'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Template'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'IP Address'|trans }}</div>
                    <div class="vps-grid-cell">{{ 'Action'|trans }}</div>
                </div>
                {% set containerRows = client.vps_containers_overview() %}
                <div id="vpsContainerRowsContainer">
                    {% for ct in containerRows %}
                        <div class="vps-grid-row mb-2 container-row" data-ctid="{{ ct.ctid }}">
                            <div class="vps-grid-cell">{{ ct.name|default('CT #' ~ ct.ctid) }} <small class="text-secondary">#{{ ct.ctid }}</small></div>
                            <div class="vps-grid-cell"><small>{{ ct.uptime_hours is not null ? (ct.uptime_hours ~ ' ' ~ ('hours'|trans)) : '-' }}</small></div>
                            <div class="vps-grid-cell">{{ ct.status|default('unknown')|upper }}</div>
                            <div class="vps-grid-cell">{{ ct.memory_mb is not null ? (ct.memory_mb ~ 'MB') : '-' }}</div>
                            <div class="vps-grid-cell"><small>{{ ct.template ?: '-' }}</small></div>
                            <div class="vps-grid-cell"><small>{{ ct.ip_address ?: '-' }}</small></div>
                            <div class="vps-grid-cell">
                                <div class="d-flex flex-nowrap gap-1">
                                    {% if ct.status != "running" %}
                                        <button class="btn btn-primary btn-sm container-action-btn" title="{{ 'Power on'|trans }}" aria-label="{{ 'Power on'|trans }}" data-action="start" data-ctid="{{ ct.ctid }}">▶</button>
                                    {% endif %}
                                    {% if ct.status == "running" %}
                                        <button class="btn btn-primary btn-sm container-action-btn" title="{{ 'Reboot'|trans }}" aria-label="{{ 'Reboot'|trans }}" data-action="reboot" data-ctid="{{ ct.ctid }}">↻</button>
                                        <button class="btn btn-secondary btn-sm container-action-btn" title="{{ 'Power off'|trans }}" aria-label="{{ 'Power off'|trans }}" data-action="stop" data-ctid="{{ ct.ctid }}">⏹</button>
                                    {% endif %}
                                    <button class="btn btn-outline-primary btn-sm container-action-btn" title="{{ 'Access details'|trans }}" aria-label="{{ 'Access details'|trans }}" data-action="access" data-ctid="{{ ct.ctid }}" data-ctname="{{ ct.name|default('CT #' ~ ct.ctid)|e('html_attr') }}">🔐</button>
                                    <button class="btn btn-outline-warning btn-sm container-action-btn" title="{{ 'Reset root password'|trans }}" aria-label="{{ 'Reset root password'|trans }}" data-action="reset-password" data-ctid="{{ ct.ctid }}">🔑</button>
                                    <button class="btn btn-danger btn-sm container-action-btn" title="{{ 'Delete container'|trans }}" aria-label="{{ 'Delete container'|trans }}" data-action="delete" data-ctid="{{ ct.ctid }}" data-ctname="{{ ct.name|default('CT #' ~ ct.ctid)|e('html_attr') }}">🗑</button>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-secondary">{{ 'No containers found for your account yet.'|trans }}</p>
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {% if not isContainersPage %}
            <section class="mt-4">
                <h4>{{ 'Create a VM'|trans }}</h4>
                <form method="post" action="{{ 'vps/provision_vm'|api_url }}" id="create-vm" class="create-vm">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <input type="hidden" name="client_id" value="{{ profile.id }}">

                    <div class="mb-3">
                        <label for="vm_name" class="form-label">{{ 'Name'|trans }}</label>
                        <input class="form-control" type="text" name="vm_name" id="vm_name" value="{{ request.vm_name|default('')|e }}" required/>
                    </div>
                    <div class="mb-3">
                        <label for="vm_os" class="form-label">{{ 'Operating System'|trans }}</label>
                        <select class="form-select" name="vm_os" id="vm_os" required>
                            <option value="" selected disabled>{{ 'Choose operating system'|trans }}</option>
                            <option value="alma9">AlmaLinux 9</option>
                            <option value="alma10">AlmaLinux 10</option>
                            <option value="rock9">Rocky Linux 9</option>
                            <option value="rock10">Rocky Linux 10</option>
                            <option value="cent9">CentOS Stream 9</option>
                            <option value="cent10">CentOS Stream 10</option>
                            <option value="ubu22">Ubuntu 22.04</option>
                            <option value="ubu24">Ubuntu 24.04</option>
														<option value="ubu26">Ubuntu 26.04</option>
                            <option value="deb135">Debian 13.5.0</option>
                            <option value="bsd151">FreeBSD 15.1</option>
                            <option disabled="disabled" value="win19">Windows Server 2019 - Coming Soon</option>
                            <option value="win22">Windows Server 2022</option>
                            <option disabled="disabled" value="win25">Windows Server 2025 - Coming Soon</option>
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="vm_cpu" class="form-label">{{ 'vCPU'|trans }}</label>
                            <input type="range" class="form-range" min="2" max="64" step="2" name="vm_cpu" id="vm_cpu" value="2" oninput="this.nextElementSibling.value = this.value" required/>
                            <output class="vm_cpu_value">2</output> vCPU
                        </div>
                        <div class="col-6">
                            <label for="vm_mem" class="form-label">{{ 'Memory'|trans }}</label>
                            <input type="range" class="form-range" min="4" max="64" step="2" name="vm_mem" id="vm_mem" value="4" oninput="this.nextElementSibling.value = this.value" required/>
                            <output class="vm_mem_value">4</output> GB
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="vm_disk_size" class="form-label">{{ 'Disk Size'|trans }}</label>
                            <input type="range" class="form-range" min="10" max="1000" step="5" name="vm_disk_size" id="vm_disk_size" value="10" oninput="this.nextElementSibling.value = this.value" required/>
                            <output class="vm_disk_size_value">10</output> GB
                        </div>
                        <div class="col-6">
                            <label for="vm_disk_type" class="form-label">{{ 'Disk Type'|trans }}</label>
                            <select class="form-select" name="vm_disk_type" id="vm_disk_type">
                                <option value="sata">SATA</option>
                                <option value="ssd">SSD</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-2">
                            <label for="vm_cost" class="form-label">{{ 'VM Cost'|trans }}</label>
                            <input class="form-control" type="text" id="vm_cost" value="$7.00" disabled />
                            <input type="hidden" name="vm_cost" id="vm_cost_hidden" value="7.00" />
                        </div>
                        <div class="col-10 d-flex align-items-end justify-content-end">
                            <button type="submit" class="btn btn-primary provision" disabled>{{ 'Provision'|trans }}</button>
                        </div>
                    </div>
                    <p class="small mt-2 mb-0 text-secondary" id="provision-eligibility-note"></p>
                </form>
            </section>
            {% endif %}
            {% if showContainerUi %}
            <section class="mt-4">
                <h4>{{ 'Provision Container'|trans }}</h4>
                {% set containerTemplates = client.vps_container_templates() %}
                <form method="post" action="{{ 'vps/container_provision'|api_url }}" id="create-container" class="create-container">
                    <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                    <input type="hidden" name="client_id" value="{{ profile.id }}">

                    <div class="mb-3">
                        <label for="ct_name" class="form-label">{{ 'Container Name'|trans }}</label>
                        <input class="form-control" type="text" name="ct_name" id="ct_name" value="" required/>
                    </div>
                    <div class="mb-3">
                        <label for="ct_template" class="form-label">{{ 'Template'|trans }}</label>
                        <select class="form-select" name="template" id="ct_template" required>
                            <option value="" selected disabled>{{ 'Choose template'|trans }}</option>
                            {% for tpl in containerTemplates %}
                                <option value="{{ tpl.volid|e('html_attr') }}">{{ tpl.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="ct_disk_size" class="form-label">{{ 'Disk Size'|trans }}</label>
                            <input type="range" class="form-range" min="10" max="1000" step="5" name="ct_disk_size" id="ct_disk_size" value="10" oninput="this.nextElementSibling.value = this.value" required/>
                            <output class="ct_disk_size_value">10</output> GB
                        </div>
                        <div class="col-6">
                            <label for="ct_disk_type" class="form-label">{{ 'Disk Type'|trans }}</label>
                            <select class="form-select" name="ct_disk_type" id="ct_disk_type">
                                <option value="sata">SATA</option>
                                <option value="ssd">SSD</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="ct_network_mode" class="form-label">{{ 'Network'|trans }}</label>
                        <select class="form-select" name="network_mode" id="ct_network_mode">
                            <option value="public">{{ 'Publicly accessible'|trans }}</option>
                            <option value="private">{{ 'Internal-only'|trans }}</option>
                        </select>
                    </div>
                    <div class="row mb-2">
                        <div class="col-3">
                            <label for="ct_cost" class="form-label">{{ 'Container Cost'|trans }}</label>
                            <input class="form-control" type="text" id="ct_cost" value="$2.00" disabled />
                        </div>
                    </div>
                    <p class="small text-secondary mb-2">{{ 'IPv4 and IPv6 are configured as DHCP automatically.'|trans }}</p>
                    <p class="small mb-2 text-secondary" id="container-eligibility-note"></p>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary container-provision-btn" disabled>{{ 'Provision Container'|trans }}</button>
                    </div>
                </form>
            </section>
            {% endif %}
            {% if not isContainersPage %}
            <section class="mt-4">
                <h4>{{ 'Accrued Usage (Uninvoiced)'|trans }}</h4>
                {% set usageSummary = client.vps_usage_summary() %}
                {% if usageSummary.rows is not empty %}
                    <p class="small text-secondary mb-2">
                        {{ 'Total accrued'|trans }}: <strong>${{ usageSummary.total_amount|number_format(4, '.', ',') }}</strong>
                        - {{ usageSummary.total_hours|number_format(2, '.', ',') }} {{ 'hours'|trans }}
                        - {{ usageSummary.vm_count }} {{ 'VMs'|trans }}
                    </p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>{{ 'VM'|trans }}</th>
                                    <th>{{ 'Hours'|trans }}</th>
                                    <th>{{ 'Amount'|trans }}</th>
                                    <th>{{ 'Period'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in usageSummary.rows %}
                                    <tr>
                                        <td>{{ row.vm_name }} <small class="text-secondary">#{{ row.vmid }}</small></td>
                                        <td>{{ row.hours|number_format(2, '.', ',') }}</td>
                                        <td>${{ row.amount|number_format(4, '.', ',') }}</td>
                                        <td>
                                            <small>
                                                {{ row.period_start ?: '-' }}<br>
                                                {{ row.period_end ?: '-' }}
                                            </small>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-secondary mb-0">{{ 'No uninvoiced VPS usage has accrued yet.'|trans }}</p>
                {% endif %}
            </section>
            {% endif %}
        </div>
    </article>
</div>

<div class="modal fade" id="powerOnModal" tabindex="-1" aria-labelledby="powerOnModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="powerOnModalLabel">{{ 'Power on'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{ 'Are you sure you want to power on this VM? CPU and disk usage will accrue towards your monthly expenses.'|trans }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'No, close'|trans }}</button>
                <button type="button" class="btn btn-primary btn-power-on">{{ 'Power on'|trans }}</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="powerOffModal" tabindex="-1" aria-labelledby="powerOffModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="powerOffModalLabel">{{ 'Power off'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{ 'Are you sure you want to power off this VM? CPU usage will stop counting toward your monthly tab, but disk usage will continue to accrue unless the VM is deleted.'|trans }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'No, go back'|trans }}</button>
                <button type="button" class="btn btn-danger btn-power-off">{{ 'Power off'|trans }}</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rebootVmModal" tabindex="-1" aria-labelledby="rebootVmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rebootVmModalLabel">{{ 'Reboot VM'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{ 'Are you sure you want to reboot this VM?'|trans }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'No, go back'|trans }}</button>
                <button type="button" class="btn btn-info btn-reboot">{{ 'Reboot'|trans }}</button>
            </div>
        </div>
    </div>
</div>

