        function pollDeleteTask(taskId) {
            var attempts = 0;
            var maxAttempts = 120;

            function checkStatus() {
                attempts += 1;
                FOSSBilling.api.client.post('vps/vm_delete_task_status',
                    { task_id: taskId },
                    function(status) {
                        if (status.status === 'completed') {
                            FOSSBilling.message('{{ 'VM deleted and billing stopped'|trans }}', 'success');
                            window.location.reload();
                            return;
                        }
                        if (status.status === 'failed') {
                            FOSSBilling.message((status.error_message || '{{ 'Delete failed'|trans }}'), 'error');
                            return;
                        }

                        if (attempts < maxAttempts) {
                            setTimeout(checkStatus, 5000);
                        }
                    },
                    function() {
                        if (attempts < maxAttempts) {
                            setTimeout(checkStatus, 5000);
                        }
                    }
                );
            }

            setTimeout(checkStatus, 2000);
        }

        getActionProgressModal().show();
        setActionProgress('{{ 'Starting VM delete...'|trans }}', '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Submitting request...'|trans }}</span></div>', false);
        postWithRetry('vps/vm_delete_async',
            { vmid: selectedVmid },
            {
            retries: 5,
            delayMs: 3000,
            onRetry: function(attempt, retries) {
                setActionProgress('{{ 'Starting VM delete...'|trans }}', '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Host busy, retrying...'|trans }} (' + attempt + '/' + retries + ')</span></div>', false);
