<div class="modal fade" id="actionProgressModal" tabindex="-1" aria-labelledby="actionProgressModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionProgressModalLabel">{{ 'Processing request...'|trans }}</h5>
            </div>
            <div class="modal-body" id="actionProgressModalBody">
                <div class="d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                    <span>{{ 'Submitting request...'|trans }}</span>
                </div>
            </div>
            <div class="modal-footer d-none" id="actionProgressModalFooter">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
    var selectedVmid = null;
    var selectedVmName = '';
    var selectedCtid = null;
    var selectedContainerName = '';
    var provisionModal = null;
    var provisionContainerModal = null;
    var actionProgressModal = null;
    var folderState = { next_id: 1, folders: [], vm_assignments: {}, container_assignments: {} };
    var currentBalance = parseFloat('{{ currentBalance|default(0) }}') || 0;
    var hasActiveSubscription = {{ hasActiveSubscription ? 'true' : 'false' }};
    var billingBypassEnabled = {{ billingBypassEnabled ? 'true' : 'false' }};

    function getProvisionModal() {
        if (!provisionModal) {
            provisionModal = new bootstrap.Modal(document.getElementById('provisionVmModal'));
        }
        return provisionModal;
    }

    function getProvisionContainerModal() {
        if (!provisionContainerModal) {
            provisionContainerModal = new bootstrap.Modal(document.getElementById('provisionContainerModal'));
        }
        return provisionContainerModal;
    }

    function getActionProgressModal() {
        if (!actionProgressModal) {
            actionProgressModal = new bootstrap.Modal(document.getElementById('actionProgressModal'));
        }
        return actionProgressModal;
    }

    function setActionProgress(title, bodyHtml, showFooter) {
        var titleEl = document.getElementById('actionProgressModalLabel');
        var bodyEl = document.getElementById('actionProgressModalBody');
        var footerEl = document.getElementById('actionProgressModalFooter');
        if (titleEl) {
            titleEl.textContent = title;
        }
        if (bodyEl) {
            bodyEl.innerHTML = bodyHtml;
        }
        if (footerEl) {
            if (showFooter) {
                footerEl.classList.remove('d-none');
            } else {
                footerEl.classList.add('d-none');
            }
        }
    }

    function postWithRetry(endpoint, payload, options) {
        var opts = options || {};
        var retries = typeof opts.retries === 'number' ? opts.retries : 4;
        var delayMs = typeof opts.delayMs === 'number' ? opts.delayMs : 2500;
        var attempt = 0;

        function run() {
            attempt += 1;
            FOSSBilling.api.client.post(endpoint, payload,
                function(result) {
                    if (typeof opts.onSuccess === 'function') {
                        opts.onSuccess(result, attempt);
                    }
                },
                function(res) {
                    if (attempt <= retries) {
                        if (typeof opts.onRetry === 'function') {
                            opts.onRetry(attempt, retries, res);
                        }
                        setTimeout(run, delayMs);
                        return;
                    }
                    if (typeof opts.onFailure === 'function') {
                        opts.onFailure(res, attempt);
                    }
                }
            );
        }

        run();
    }

    function loadFolderState(callback) {
        FOSSBilling.api.client.post('vps/vm_folders', {},
            function(result) {
                folderState = result || { next_id: 1, folders: [], vm_assignments: {}, container_assignments: {} };
                folderState.vm_assignments = folderState.vm_assignments || folderState.assignments || {};
                folderState.container_assignments = folderState.container_assignments || {};
                if (typeof callback === 'function') {
                    callback();
                }
            },
            function() {
                if (typeof callback === 'function') {
                    callback();
                }
            }
        );
    }

    function applyFolderStateAndRender(result) {
        if (result) {
            folderState = result;
            folderState.vm_assignments = folderState.vm_assignments || folderState.assignments || {};
            folderState.container_assignments = folderState.container_assignments || {};
            refreshFolderDeleteSelect();
            groupVmRowsByFolder();
            groupContainerRowsByFolder();
            return;
        }

        loadFolderState(function() {
            groupVmRowsByFolder();
            groupContainerRowsByFolder();
        });
    }

    function refreshFolderDeleteSelect() {
        var deleteSelect = document.getElementById('deleteVmFolderSelect');
        if (!deleteSelect) {
            return;
        }
        deleteSelect.innerHTML = '<option value="">{{ 'Select folder to delete'|trans }}</option>';
        (folderState.folders || []).forEach(function(folder) {
            var opt = document.createElement('option');
            opt.value = String(folder.id);
            opt.textContent = folder.name || ('Folder ' + folder.id);
            deleteSelect.appendChild(opt);
        });
    }

    function createFolderSelect(entityType, entityId) {
        var select = document.createElement('select');
        select.className = 'form-select form-select-sm';
        select.style.maxWidth = '160px';
        var optUngrouped = document.createElement('option');
        optUngrouped.value = '';
        optUngrouped.textContent = '{{ 'Ungrouped'|trans }}';
        select.appendChild(optUngrouped);

        (folderState.folders || []).forEach(function(folder) {
            var option = document.createElement('option');
            option.value = String(folder.id);
            option.textContent = folder.name;
            select.appendChild(option);
        });

        var assignmentMap = entityType === 'container'
            ? (folderState.container_assignments || {})
            : (folderState.vm_assignments || {});
        var assigned = assignmentMap[String(entityId)] ? String(assignmentMap[String(entityId)]) : '';
        select.value = assigned;
        select.addEventListener('change', function() {
            var endpoint = entityType === 'container' ? 'vps/container_folder_assign' : 'vps/vm_folder_assign';
            var payload = entityType === 'container'
                ? { ctid: entityId, folder_id: select.value }
                : { vmid: entityId, folder_id: select.value };
            FOSSBilling.api.client.post(endpoint,
                payload,
                function(result) {
                    folderState = result || folderState;
                    folderState.vm_assignments = folderState.vm_assignments || folderState.assignments || {};
                    folderState.container_assignments = folderState.container_assignments || {};
                    groupVmRowsByFolder();
                    groupContainerRowsByFolder();
                },
                function(res) {
                    FOSSBilling.message((res.message || 'Folder assignment failed') + (res.code ? ' (' + res.code + ')' : ''), 'error');
                }
            );
        });

        return select;
    }

    function groupVmRowsByFolder() {
        var container = document.getElementById('vpsVmRowsContainer');
        if (!container) {
            return;
        }
        refreshFolderDeleteSelect();
        var rows = Array.from(container.querySelectorAll('.vm-row'));
        var snapshotRowsByVmid = {};
        Array.from(container.querySelectorAll('.vm-snapshot-row')).forEach(function(snapshotRow) {
            var vmid = String(snapshotRow.dataset.vmid || '');
            if (!vmid) {
                return;
            }
            snapshotRowsByVmid[vmid] = snapshotRow;
        });
        if (!rows.length) {
            return;
        }

        rows.forEach(function(row) {
            var vmid = String(row.dataset.vmid || '');
            var actionCell = row.querySelector('.vps-grid-cell:last-child');
            if (actionCell && !actionCell.querySelector('.vm-folder-select-wrap')) {
                var wrap = document.createElement('div');
                wrap.className = 'vm-folder-select-wrap ms-1';
                wrap.appendChild(createFolderSelect('vm', vmid));
                actionCell.querySelector('.d-flex')?.appendChild(wrap);
            }
        });

        var byFolder = { '0': [] };
        rows.forEach(function(row) {
            var vmid = String(row.dataset.vmid || '0');
            var folderId = String((folderState.vm_assignments && folderState.vm_assignments[vmid]) ? folderState.vm_assignments[vmid] : 0);
            if (!byFolder[folderId]) {
                byFolder[folderId] = [];
            }
            byFolder[folderId].push(row);
        });

        container.innerHTML = '';

        function appendSection(folderId, folderName, collapsed, sectionRows) {
            var rowsForSection = Array.isArray(sectionRows) ? sectionRows : [];
            if (folderId === '0' && rowsForSection.length === 0) {
                return;
            }
            var details = document.createElement('details');
            details.className = 'mb-2';
            details.dataset.folderId = folderId;
            details.open = !collapsed;
            var summary = document.createElement('summary');
            summary.className = 'd-flex align-items-center gap-2 mb-2';
            summary.innerHTML = '<strong>' + folderName + '</strong> <small>(' + rowsForSection.length + ')</small>';
            if (folderId !== '0') {
                var renameBtn = document.createElement('button');
                renameBtn.type = 'button';
                renameBtn.className = 'btn btn-outline-secondary btn-sm ms-2 folder-rename-btn';
                renameBtn.dataset.folderId = folderId;
                renameBtn.textContent = '{{ 'Rename'|trans }}';
                summary.appendChild(renameBtn);

                var deleteBtn = document.createElement('button');
                deleteBtn.type = 'button';
                deleteBtn.className = 'btn btn-outline-danger btn-sm folder-delete-btn';
                deleteBtn.dataset.folderId = folderId;
                deleteBtn.textContent = '{{ 'Delete'|trans }}';
                summary.appendChild(deleteBtn);
            }
            details.appendChild(summary);
            if (rowsForSection.length === 0) {
                var empty = document.createElement('p');
                empty.className = 'text-secondary mb-2';
                empty.textContent = '{{ 'No VMs in this folder yet.'|trans }}';
                details.appendChild(empty);
            } else {
                rowsForSection.forEach(function(row) {
                    details.appendChild(row);
                    var vmid = String(row.dataset.vmid || '');
                    if (snapshotRowsByVmid[vmid]) {
                        details.appendChild(snapshotRowsByVmid[vmid]);
                    }
                });
            }
            details.addEventListener('toggle', function() {
                if (folderId === '0') {
                    return;
                }
                FOSSBilling.api.client.post('vps/vm_folder_toggle', {
                    folder_id: folderId,
                    collapsed: details.open ? 0 : 1,
                    scope: 'vm'
                }, function(result) {
                    folderState = result || folderState;
                }, function() {});
            });
            container.appendChild(details);
        }

        appendSection('0', '{{ 'Ungrouped'|trans }}', false, byFolder['0'] || []);
        (folderState.folders || []).forEach(function(folder) {
            appendSection(String(folder.id), folder.name || ('Folder ' + folder.id), !!folder.collapsed, byFolder[String(folder.id)] || []);
        });
    }

    function groupContainerRowsByFolder() {
        var container = document.getElementById('vpsContainerRowsContainer');
        if (!container) {
            return;
        }
        var rows = Array.from(container.querySelectorAll('.container-row'));
        if (!rows.length) {
            return;
        }

        rows.forEach(function(row) {
            var ctid = String(row.dataset.ctid || '');
            var actionCell = row.querySelector('.vps-grid-cell:last-child');
            if (actionCell && !actionCell.querySelector('.container-folder-select-wrap')) {
                var wrap = document.createElement('div');
                wrap.className = 'container-folder-select-wrap ms-1';
                wrap.appendChild(createFolderSelect('container', ctid));
                actionCell.querySelector('.d-flex')?.appendChild(wrap);
            }
        });

        var byFolder = { '0': [] };
        rows.forEach(function(row) {
            var ctid = String(row.dataset.ctid || '0');
            var folderId = String((folderState.container_assignments && folderState.container_assignments[ctid]) ? folderState.container_assignments[ctid] : 0);
            if (!byFolder[folderId]) {
                byFolder[folderId] = [];
            }
            byFolder[folderId].push(row);
        });

        container.innerHTML = '';

        function appendSection(folderId, folderName, collapsed, sectionRows) {
            var rowsForSection = Array.isArray(sectionRows) ? sectionRows : [];
            if (folderId === '0' && rowsForSection.length === 0) {
                return;
            }
            var details = document.createElement('details');
            details.className = 'mb-2';
            details.dataset.folderId = folderId;
            details.open = !collapsed;
            var summary = document.createElement('summary');
            summary.className = 'd-flex align-items-center gap-2 mb-2';
            summary.innerHTML = '<strong>' + folderName + '</strong> <small>(' + rowsForSection.length + ')</small>';
            details.appendChild(summary);

            if (rowsForSection.length === 0) {
                var empty = document.createElement('p');
                empty.className = 'text-secondary mb-2';
                empty.textContent = '{{ 'No containers in this folder yet.'|trans }}';
                details.appendChild(empty);
            } else {
                rowsForSection.forEach(function(row) {
                    details.appendChild(row);
                });
            }

            details.addEventListener('toggle', function() {
                if (folderId === '0') {
                    return;
                }
                FOSSBilling.api.client.post('vps/vm_folder_toggle', {
                    folder_id: folderId,
                    collapsed: details.open ? 0 : 1,
                    scope: 'container'
                }, function(result) {
                    folderState = result || folderState;
                    folderState.vm_assignments = folderState.vm_assignments || folderState.assignments || {};
                    folderState.container_assignments = folderState.container_assignments || {};
                }, function() {});
            });

            container.appendChild(details);
        }

        appendSection('0', '{{ 'Ungrouped'|trans }}', false, byFolder['0'] || []);
        (folderState.folders || []).forEach(function(folder) {
            appendSection(String(folder.id), folder.name || ('Folder ' + folder.id), !!folder.container_collapsed, byFolder[String(folder.id)] || []);
        });
    }

    var createFolderButton = document.getElementById('createVmFolderBtn');
    if (createFolderButton) {
        createFolderButton.addEventListener('click', function() {
            var input = document.getElementById('newVmFolderName');
            var name = input ? input.value.trim() : '';
            if (!name) {
                name = (prompt('{{ 'Enter a folder name'|trans }}') || '').trim();
            }
            if (!name) {
                FOSSBilling.message('{{ 'Folder name is required'|trans }}', 'error');
                return;
            }

            FOSSBilling.api.client.post('vps/vm_folder_create', { name: name },
                function(result) {
                    if (input) {
                        input.value = '';
                    }
                    applyFolderStateAndRender(result);
                },
                function(res) {
                    FOSSBilling.message((res.message || 'Folder creation failed') + (res.code ? ' (' + res.code + ')' : ''), 'error');
                }
            );
        });
    }

    var deleteFolderButton = document.getElementById('deleteVmFolderBtn');
    if (deleteFolderButton) {
        deleteFolderButton.addEventListener('click', function() {
            var select = document.getElementById('deleteVmFolderSelect');
            var folderId = select ? String(select.value || '') : '';
            if (!folderId) {
                FOSSBilling.message('{{ 'Select a folder to delete'|trans }}', 'error');
                return;
            }
            if (!confirm('{{ 'Delete this folder? Assigned VMs and containers will become ungrouped.'|trans }}')) {
                return;
            }
            FOSSBilling.api.client.post('vps/vm_folder_delete', { folder_id: folderId },
                function(result) {
                    if (select) {
                        select.value = '';
                    }
                    applyFolderStateAndRender(result);
                },
                function(res) {
                    FOSSBilling.message((res.message || 'Delete failed') + (res.code ? ' (' + res.code + ')' : ''), 'error');
                }
            );
        });
    }

    document.querySelectorAll('.vm-action-btn').forEach(function(button) {
        button.addEventListener('click', function() {
            selectedVmid = button.dataset.vmid;
            selectedVmName = button.dataset.vmname || '';
            var label = document.getElementById('rebootVmModalLabel');
            if (label && button.dataset.action === 'reboot') {
                label.textContent = '{{ 'Reboot VM'|trans }} ' + selectedVmid;
            }
            if (button.dataset.action === 'duplicate') {
                var duplicateName = document.getElementById('duplicate_vm_name');
                if (duplicateName) {
                    duplicateName.value = (selectedVmName || ('vm-' + selectedVmid)) + '-copy';
                }
            }
            if (button.dataset.action === 'delete') {
                var deleteBody = document.getElementById('deleteVmModalBody');
                if (deleteBody) {
                    deleteBody.textContent = '{{ 'This will permanently delete the VM and stop billing from today. Are you sure?'|trans }}' + ' (' + (selectedVmName || ('VM #' + selectedVmid)) + ')';
                }
            }
            if (button.dataset.action === 'access') {
                showVmAccessDetails();
            }
            if (button.dataset.action === 'reset-password') {
                if (!confirm('{{ 'Reset root password now? This will restart cloud-init credential flow.'|trans }}')) {
                    return;
                }
                getActionProgressModal().show();
                setActionProgress('{{ 'Resetting VM root password...'|trans }}', '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Submitting request...'|trans }}</span></div>', false);
                postWithRetry('vps/vm_reset_root_password', { vmid: selectedVmid }, {
                    retries: 5,
                    delayMs: 3000,
                    onRetry: function(attempt, retries) {
                        setActionProgress('{{ 'Resetting VM root password...'|trans }}', '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Host busy, retrying...'|trans }} (' + attempt + '/' + retries + ')</span></div>', false);
                    },
                    onSuccess: function(result) {
                        var body = document.getElementById('vmAccessModalBody');
                        if (body) {
                            body.innerHTML = '<p class="text-success mb-2"><strong>{{ 'Root password reset complete'|trans }}</strong></p>'
                                + '<p class="mb-1">{{ 'VM ID'|trans }}: <strong>' + escapeHtml(result.vmid) + '</strong></p>'
                                + '<p class="mb-1">{{ 'IP address'|trans }}: <strong>' + escapeHtml(result.ip_address || '-') + '</strong></p>'
                                + '<p class="mb-0">{{ 'Root password'|trans }}: <code>' + escapeHtml(result.root_password || '') + '</code></p>';
                            var modalEl = document.getElementById('vmAccessModal');
                            if (modalEl) {
                                new bootstrap.Modal(modalEl).show();
                            }
                        }
                        setActionProgress('{{ 'Action completed'|trans }}', '<p class="text-success mb-0"><strong>{{ 'Root password reset requested'|trans }}</strong></p>', true);
                    },
                    onFailure: function(res) {
                        setActionProgress('{{ 'Action failed'|trans }}', '<p class="text-danger mb-0"><strong>{{ 'Password reset failed after retries.'|trans }}</strong><br>' + escapeHtml((res && res.message) ? res.message : 'Unknown error') + '</p>', true);
                    }
                });
            }
            if (button.dataset.action === 'take-snapshot') {
                if (!confirm('{{ 'Take a snapshot now? Snapshot storage will be billed at SATA disk rates while it exists.'|trans }}')) {
                    return;
                }
                getActionProgressModal().show();
                setActionProgress('{{ 'Starting snapshot...'|trans }}', '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Submitting request...'|trans }}</span></div>', false);
                postWithRetry('vps/vm_snapshot_take_async', { vmid: selectedVmid }, {
                    retries: 5,
                    delayMs: 3000,
                    onRetry: function(attempt, retries) {
                        setActionProgress('{{ 'Starting snapshot...'|trans }}', '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div><span>{{ 'Host busy, retrying...'|trans }} (' + attempt + '/' + retries + ')</span></div>', false);
                    },
